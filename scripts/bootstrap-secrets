#!/usr/bin/env bash

set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
private_dir="$repo_root/.secrets"
private_key="$private_dir/age-key.txt"
encrypted_key="$repo_root/secrets/age-key.txt.age"
sops_file="$repo_root/secrets/secrets.yaml"
sops_config="$repo_root/.sops.yaml"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

[[ ! -e "$private_key" ]] || die "$private_key already exists"
[[ ! -e "$encrypted_key" ]] || die "$encrypted_key already exists"
[[ ! -e "$sops_file" ]] || die "$sops_file already exists"

umask 077
install -d -m 0700 "$private_dir" "$repo_root/secrets"

cleanup_on_error() {
  status=$?
  if (( status != 0 )); then
    rm -f -- "$private_key" "$encrypted_key" "$sops_file"
    if [[ -n "${public_key:-}" ]]; then
      sed -i "s/$public_key/AGE_PUBLIC_KEY_REPLACED_BY_BOOTSTRAP/" "$sops_config"
    fi
  fi
  exit "$status"
}
trap cleanup_on_error EXIT

printf 'Generating the age identity...\n'
nix shell nixpkgs#age --command age-keygen --output "$private_key"
public_key="$(nix shell nixpkgs#age --command age-keygen -y "$private_key")"

sed -i "s/AGE_PUBLIC_KEY_REPLACED_BY_BOOTSTRAP/$public_key/" "$sops_config"

printf '\nChoose a strong passphrase for the Git copy of the private key.\n'
nix shell nixpkgs#age --command \
  age --passphrase --armor --output "$encrypted_key" "$private_key"

printf '\nChoose the password for the ryuk account.\n'
read -r -s -p 'Password: ' login_password
printf '\n'
read -r -s -p 'Confirm password: ' login_password_confirmation
printf '\n'
[[ "$login_password" == "$login_password_confirmation" ]] || \
  die "the ryuk passwords did not match"
password_hash="$(
  printf '%s\n' "$login_password" | \
    nix shell nixpkgs#whois --command mkpasswd --method=yescrypt --stdin
)"
unset login_password login_password_confirmation
printf 'users:\n  ryuk-password: %s\n' "$password_hash" >"$sops_file"

SOPS_AGE_KEY_FILE="$private_key" \
  nix shell nixpkgs#sops --command sops --encrypt --in-place "$sops_file"

trap - EXIT
printf '\nSecrets initialized.\n'
printf 'Store this private key in Bitwarden before deleting it:\n  %s\n' "$private_key"
printf 'After verifying the Bitwarden copy, remove the plaintext with:\n'
printf '  rm -- %s\n' "$private_key"
printf 'Commit only these encrypted/public files:\n'
printf '  %s\n  %s\n  %s\n' "$encrypted_key" "$sops_file" "$sops_config"
printf 'Verify the login password without exposing its hash with:\n'
printf '  %s/scripts/verify-login-password\n' "$repo_root"
