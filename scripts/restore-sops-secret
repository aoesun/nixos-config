#!/usr/bin/env bash

set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
sops_file="$repo_root/secrets/secrets.yaml"
temporary_secret="$(mktemp)"

cleanup() {
  rm -f -- "$temporary_secret"
}
trap cleanup EXIT
chmod 0600 "$temporary_secret"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

# Add future secrets to these parallel arrays. Each entry defines its display
# name, sops --extract path, default destination, private filename, file mode,
# owner, group, and validation type. Keep indexes aligned.
secret_labels=(
  "GitHub SSH private key"
)
secret_paths=(
  '["github"]["ssh-private-key"]'
)
secret_destinations=(
  "/home/ryuk/.ssh/id_ed25519"
)
secret_filenames=(
  "github-id_ed25519"
)
secret_modes=(
  "0600"
)
secret_owners=(
  "ryuk"
)
secret_groups=(
  "users"
)
secret_validators=(
  "openssh-private-key"
)

find_age_identity() {
  local candidate

  if [[ -n "${SOPS_AGE_KEY_FILE:-}" ]]; then
    [[ -r "$SOPS_AGE_KEY_FILE" ]] || die "SOPS_AGE_KEY_FILE is not readable: $SOPS_AGE_KEY_FILE"
    printf '%s\n' "$SOPS_AGE_KEY_FILE"
    return
  fi

  for candidate in \
    "/persist/var/lib/sops-nix/key.txt" \
    "$repo_root/.secrets/key.txt" \
    "$repo_root/.secrets/age-key.txt"; do
    if [[ -r "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  die "no age identity found; run scripts/restore-age-key or set SOPS_AGE_KEY_FILE"
}

validate_secret() {
  case "$1" in
    openssh-private-key)
      ssh-keygen -y -f "$temporary_secret" >/dev/null 2>&1 || \
        die "the decrypted value is not a valid OpenSSH private key"
      ;;
    nonempty)
      [[ -s "$temporary_secret" ]] || die "the decrypted value is empty"
      ;;
    *)
      die "unknown secret validator: $1"
      ;;
  esac
}

printf 'Restore a secret from %s:\n' "$sops_file"
for index in "${!secret_labels[@]}"; do
  printf '  %d) %s\n' "$((index + 1))" "${secret_labels[$index]}"
done
custom_choice=$((${#secret_labels[@]} + 1))
printf '  %d) Custom sops path\n' "$custom_choice"
read -r -p "Secret [1-$custom_choice]: " selection

[[ "$selection" =~ ^[0-9]+$ ]] || die "invalid secret selection"
if (( selection >= 1 && selection <= ${#secret_labels[@]} )); then
  index=$((selection - 1))
  label="${secret_labels[$index]}"
  sops_path="${secret_paths[$index]}"
  default_destination="${secret_destinations[$index]}"
  private_filename="${secret_filenames[$index]}"
  mode="${secret_modes[$index]}"
  owner="${secret_owners[$index]}"
  group="${secret_groups[$index]}"
  validator="${secret_validators[$index]}"
else
  (( selection == custom_choice )) || die "invalid secret selection"
  label="custom secret"
  read -r -p 'SOPS extract path (for example ["service"]["private-key"]): ' sops_path
  [[ -n "$sops_path" ]] || die "the sops path cannot be empty"
  default_destination=""
  read -r -p 'Filename for .secrets: ' private_filename
  [[ -n "$private_filename" && "$private_filename" != */* ]] || \
    die "the private filename must be a single non-empty path component"
  mode="0600"
  owner="$(id -un)"
  group="$(id -gn)"
  validator="nonempty"
fi

age_identity="$(find_age_identity)"
printf 'Decrypting and validating %s...\n' "$label"
SOPS_AGE_KEY_FILE="$age_identity" \
  nix shell nixpkgs#sops --command \
    sops --decrypt --extract "$sops_path" "$sops_file" >"$temporary_secret"
validate_secret "$validator"

printf '\nSave the verified secret to:\n'
if [[ -n "$default_destination" ]]; then
  printf '  1) Runtime default (%s)\n' "$default_destination"
  printf '  2) Repository private directory (%s/.secrets/%s)\n' "$repo_root" "$private_filename"
  printf '  3) Custom absolute path\n'
  read -r -p 'Destination [1-3]: ' destination_choice
  case "$destination_choice" in
    1) destination="$default_destination" ;;
    2) destination="$repo_root/.secrets/$private_filename" ;;
    3) read -r -p 'Absolute destination path: ' destination ;;
    *) die "invalid destination selection" ;;
  esac
else
  printf '  1) Repository private directory (%s/.secrets/%s)\n' "$repo_root" "$private_filename"
  printf '  2) Custom absolute path\n'
  read -r -p 'Destination [1-2]: ' destination_choice
  case "$destination_choice" in
    1) destination="$repo_root/.secrets/$private_filename" ;;
    2) read -r -p 'Absolute destination path: ' destination ;;
    *) die "invalid destination selection" ;;
  esac
fi
[[ "$destination" == /* ]] || die "the destination must be absolute"

if [[ -e "$destination" ]]; then
  if cmp -s -- "$temporary_secret" "$destination"; then
    printf '%s already contains the same secret; nothing was changed.\n' "$destination"
    exit 0
  fi

  printf '%s exists and differs from the restored secret.\n' "$destination"
  if [[ "$validator" == openssh-private-key && -r "$destination" ]]; then
    printf 'Existing key: '
    ssh-keygen -lf "$destination" || printf 'not a valid readable OpenSSH private key\n'
    printf 'Restored key: '
    ssh-keygen -lf "$temporary_secret"
  else
    printf 'Existing size: %s bytes; restored size: %s bytes.\n' \
      "$(stat -c %s "$destination" 2>/dev/null || printf unreadable)" \
      "$(stat -c %s "$temporary_secret")"
  fi
  read -r -p "$destination already exists; type yes to replace it: " replace_confirmation
  [[ "$replace_confirmation" == yes ]] || die "existing destination was left unchanged"
fi

if [[ $EUID -eq 0 ]]; then
  install -D -m "$mode" -o "$owner" -g "$group" "$temporary_secret" "$destination"
elif [[ "$owner" == "$(id -un)" && "$group" == "$(id -gn)" ]]; then
  install -D -m "$mode" "$temporary_secret" "$destination"
else
  sudo install -D -m "$mode" -o "$owner" -g "$group" "$temporary_secret" "$destination"
fi

printf '%s was restored to %s with mode %s and owner %s:%s.\n' \
  "$label" "$destination" "$mode" "$owner" "$group"
