#!/usr/bin/env bash

set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
private_key="$repo_root/.secrets/age-key.txt"
sops_file="$repo_root/secrets/secrets.yaml"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

[[ -f "$private_key" ]] || die "missing $private_key"
[[ -f "$sops_file" ]] || die "missing $sops_file"

password_hash="$(
  SOPS_AGE_KEY_FILE="$private_key" \
    nix shell nixpkgs#sops --command \
      sops --decrypt --extract '["users"]["ryuk-password"]' "$sops_file"
)"

read -r -s -p 'Password to verify: ' login_password
printf '\n'

if printf '%s\n' "$login_password" | PASSWORD_HASH="$password_hash" perl -e '
  chomp(my $password = <STDIN>);
  exit crypt($password, $ENV{PASSWORD_HASH}) eq $ENV{PASSWORD_HASH} ? 0 : 1;
'; then
  printf 'The password matches the encrypted login hash.\n'
else
  printf 'The password does not match the encrypted login hash.\n' >&2
  exit 1
fi
